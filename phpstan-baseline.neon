parameters:
	ignoreErrors:
		-
			message: "#^\\\\Drupal calls should be avoided in classes, use dependency injection instead$#"
			count: 1
			path: src/Plugin/BootstrapStyles/Style/BackgroundColor.php

		-
			message: "#^\\\\Drupal calls should be avoided in classes, use dependency injection instead$#"
			count: 3
			path: src/Plugin/BootstrapStyles/Style/BackgroundMedia.php

		-
			message: "#^\\\\Drupal calls should be avoided in classes, use dependency injection instead$#"
			count: 1
			path: src/Plugin/BootstrapStyles/Style/Border.php

		-
			message: "#^\\\\Drupal calls should be avoided in classes, use dependency injection instead$#"
			count: 2
			path: src/StylesGroup/StylesGroupPluginBase.php

		# 1.1.x supports Drupal < 10.3 only, so it never runs on Drupal 11.2+
		# where annotation-only plugin managers are deprecated. Attribute
		# discovery is added on the 1.2.x and 2.0.x branches.
		-
			identifier: pluginManager.attributeDiscoveryMissing
			count: 1
			path: src/Style/StyleManager.php

		-
			identifier: pluginManager.attributeDiscoveryMissing
			count: 1
			path: src/StylesGroup/StylesGroupManager.php
